# PostgreSQL Database URL (Recommended: Neon.tech 100% Free Tier)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zata_room?schema=public"

# Master secret for AES-256-GCM encryption of user API keys (must be 64 hex characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Upstash QStash Token for headless background orchestration when browser is closed
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
